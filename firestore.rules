rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isActive() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status != 'Disabled';
    }

    function isAdmin() {
      return isActive() && getUserData().role == 'ADMIN';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function hasPerm(module, action) {
      return isActive() && (
        getUserData().role == 'ADMIN' ||
        (
          getUserData().get('permissions', null) != null &&
          getUserData().get('permissions', {}).get(module, {}).get('access', false) == true &&
          getUserData().get('permissions', {}).get(module, {}).get(action, false) == true
        ) ||
        (
          getUserData().get('permissions', null) == null && (
            (getUserData().role == 'STORE' && (
              (module == 'inventory' && action in ['view', 'add', 'edit']) ||
              (module == 'partsIssue' && action in ['view', 'issuePart']) ||
              (module == 'workshop' && action in ['view', 'approveIn', 'approveOut']) ||
              (module in ['clients', 'machines', 'serviceReports', 'workEntries'] && action == 'view')
            )) ||
            (getUserData().role == 'ENGINEER' && (
              (module == 'serviceReports' && action in ['view', 'add', 'edit']) ||
              (module == 'workEntries' && action in ['view', 'add', 'edit', 'delete']) ||
              (module == 'workshop' && action in ['view', 'createIn', 'addActivity', 'markReady', 'prepareOut']) ||
              (module == 'engineerBag' && action == 'view') ||
              (module in ['clients', 'machines', 'inventory'] && action == 'view')
            ))
          )
        )
      );
    }
    
    // Users Collection
    match /users/{userId} {
      // A disabled user can read their own record to discover account revocation.
      allow read: if isSignedIn() && (isOwner(userId) || isActive());
      allow create: if isAdmin();
      // Only an active administrator may change identity, role, status or rights.
      // Delegated rights managers may modify non-admin user permissions only.
      allow update: if isAdmin() || (
        hasPerm('users', 'manageRights') &&
        !isOwner(userId) &&
        resource.data.role != 'ADMIN' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions'])
      );
      allow delete: if isAdmin();
    }
    
    match /entries/{entryId} {
      allow get, list: if isActive() && (
        isAdmin() || hasPerm('reports', 'export') ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == getUserData().userId
      );
      allow create: if hasPerm('workEntries', 'add') &&
        request.resource.data.userId == request.auth.uid;
      allow update: if hasPerm('workEntries', 'edit') &&
        (isAdmin() || resource.data.userId == request.auth.uid ||
          resource.data.userId == getUserData().userId) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if hasPerm('workEntries', 'delete') &&
        (isAdmin() || resource.data.userId == request.auth.uid ||
          resource.data.userId == getUserData().userId);
    }
    
    match /config/{document=**} {
      allow read: if isActive();
      // Sequence changes are authoritative backend operations (Admin SDK).
      allow write: if isAdmin();
    }
    
    match /serviceReports/{reportId} {
      allow get, list: if isActive();
      allow create: if hasPerm('serviceReports', 'add') &&
        request.resource.data.userId in [request.auth.uid, getUserData().userId];
      allow update: if hasPerm('serviceReports', 'edit') &&
        (isAdmin() || resource.data.userId in [request.auth.uid, getUserData().userId]) &&
        request.resource.data.userId == resource.data.userId;
      // Permit deletion of ONLY an engineer's entry-derived report, never a
      // standalone service report or another engineer's linked record.
      allow delete: if hasPerm('serviceReports', 'delete') || (
        hasPerm('workEntries', 'delete') &&
        reportId.matches('entry_.*') &&
        (
          resource == null || (
            resource.data.userId in [request.auth.uid, getUserData().userId] &&
            reportId == 'entry_' + resource.data.linkedEntryId
          )
        )
      );
    }
    
    match /inventory/{itemId} {
      allow get, list: if isActive();
      allow create: if hasPerm('inventory', 'add') &&
        request.resource.data.quantity is int && request.resource.data.quantity >= 0;
      allow update: if hasPerm('inventory', 'edit') &&
        request.resource.data.quantity is int && request.resource.data.quantity >= 0;
      allow delete: if hasPerm('inventory', 'delete');
    }
    
    match /engineerBags/{bagItemId} {
      allow get, list: if isActive();
      allow create: if hasPerm('engineerBag', 'add') || hasPerm('partsIssue', 'issuePart');
      allow update: if hasPerm('engineerBag', 'edit') || hasPerm('partsIssue', 'issuePart');
      allow delete: if hasPerm('engineerBag', 'delete') || hasPerm('partsIssue', 'cancelIssue');
    }
    
    match /partTransactions/{transactionId} {
      allow get, list: if isActive();
      allow create: if hasPerm('partsIssue', 'issuePart') || (
        // Engineers can request a bag return; only Store/Admin receives it.
        hasPerm('engineerBag', 'view') &&
        request.resource.data.engineerId == getUserData().userId &&
        request.resource.data.sourceType == 'MY BAG' &&
        request.resource.data.destinationType == 'STORE' &&
        request.resource.data.status == 'WITH ENGINEER' &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0 &&
        request.resource.data.returnInitiatedAt is int
      );
      allow update: if hasPerm('partsIssue', 'cancelIssue') || (
        hasPerm('partsIssue', 'issuePart') &&
        resource.data.sourceType == 'MY BAG' &&
        resource.data.destinationType == 'STORE' &&
        resource.data.status == 'WITH ENGINEER' &&
        request.resource.data.status == 'RETURNED' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'storeReceivedAt', 'storeReceivedBy', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }
    
    match /clients/{clientId} {
      allow get, list: if isActive();
      allow create: if hasPerm('clients', 'add');
      allow update: if hasPerm('clients', 'edit');
      allow delete: if hasPerm('clients', 'delete');
    }
    
    match /customerMachines/{machineId} {
      allow get, list: if isActive();
      allow create: if hasPerm('machines', 'add');
      allow update: if hasPerm('machines', 'edit');
      allow delete: if hasPerm('machines', 'delete');
    }
    
    match /workshopCases/{caseId} {
      allow get, list: if isActive();
      allow create: if hasPerm('workshop', 'createIn');
      allow update: if hasPerm('workshop', 'addActivity') || hasPerm('workshop', 'markReady') || hasPerm('workshop', 'prepareOut') || hasPerm('workshop', 'approveIn') || hasPerm('workshop', 'approveOut') || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
