rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'ADMIN';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function hasPerm(module, action) {
      return isSignedIn() && (
        getUserData().role == 'ADMIN' ||
        (
          getUserData().permissions != null &&
          getUserData().permissions.get(module, {}).get('access', false) == true &&
          getUserData().permissions.get(module, {}).get(action, false) == true
        ) ||
        (
          getUserData().permissions == null && (
            (getUserData().role == 'STORE' && (
              (module == 'inventory' && action in ['view', 'add', 'edit']) ||
              (module == 'partsIssue' && action in ['view', 'issuePart']) ||
              (module == 'workshop' && action in ['view', 'approveIn', 'approveOut']) ||
              (module in ['clients', 'machines', 'serviceReports', 'workEntries'] && action == 'view')
            )) ||
            (getUserData().role == 'ENGINEER' && (
              (module == 'serviceReports' && action in ['view', 'add', 'edit']) ||
              (module == 'workEntries' && action in ['view', 'add', 'edit']) ||
              (module == 'workshop' && action in ['view', 'createIn', 'addActivity', 'markReady', 'prepareOut']) ||
              (module == 'engineerBag' && action == 'view') ||
              (module in ['clients', 'machines', 'inventory'] && action == 'view')
            ))
          )
        )
      );
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin() || hasPerm('users', 'manageRights') || hasPerm('users', 'edit');
      allow delete: if isAdmin() || hasPerm('users', 'deleteUser');
    }
    
    match /entries/{entryId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('workEntries', 'add');
      allow update: if hasPerm('workEntries', 'edit');
      allow delete: if hasPerm('workEntries', 'delete');
    }
    
    match /config/{document=**} {
      allow read, write: if isSignedIn();
    }
    
    match /serviceReports/{reportId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('serviceReports', 'add');
      allow update: if hasPerm('serviceReports', 'edit');
      allow delete: if hasPerm('serviceReports', 'delete');
    }
    
    match /inventory/{itemId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('inventory', 'add');
      allow update: if hasPerm('inventory', 'edit');
      allow delete: if hasPerm('inventory', 'delete');
    }
    
    match /engineerBags/{bagItemId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('engineerBag', 'add') || hasPerm('partsIssue', 'issuePart');
      allow update: if hasPerm('engineerBag', 'edit') || hasPerm('partsIssue', 'issuePart');
      allow delete: if hasPerm('engineerBag', 'delete') || hasPerm('partsIssue', 'cancelIssue');
    }
    
    match /partTransactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('partsIssue', 'issuePart');
      allow update: if hasPerm('partsIssue', 'cancelIssue');
      allow delete: if isAdmin();
    }
    
    match /clients/{clientId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('clients', 'add');
      allow update: if hasPerm('clients', 'edit');
      allow delete: if hasPerm('clients', 'delete');
    }
    
    match /customerMachines/{machineId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('machines', 'add');
      allow update: if hasPerm('machines', 'edit');
      allow delete: if hasPerm('machines', 'delete');
    }
    
    match /workshopCases/{caseId} {
      allow get, list: if isSignedIn();
      allow create: if hasPerm('workshop', 'createIn');
      allow update: if hasPerm('workshop', 'addActivity') || hasPerm('workshop', 'markReady') || hasPerm('workshop', 'prepareOut') || hasPerm('workshop', 'approveIn') || hasPerm('workshop', 'approveOut') || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
